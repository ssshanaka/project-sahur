   "source": [
    "---\n",
    "# Module 5 — Dataset Engineering\n",
    "\n",
    "We are no longer observers; we are creators. In this module, we build the **Enterprise Data Pipeline** to take raw, messy synthetic data generated by a Teacher model (like GPT-4) and mathematically scrub it into a pristine Hugging Face dataset.\n",
    "\n",
    "The pipeline has 4 stages:\n",
    "1. **Clean** - Remove structural corruption and markdown bleed.\n",
    "2. **Deduplicate** - Remove exact and fuzzy matches to prevent overfitting.\n",
    "3. **Balance** - Analyze turn counts and length distributions.\n",
    "4. **Format** - Force injection of the Golden System Prompt and map to the Hugging Face `messages` standard."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "import hashlib\n",
    "import re\n",
    "import statistics\n",
    "\n",
    "SAHUR_SYSTEM_PROMPT = (\n",
    "    \"You are Sahur, a highly intelligent Gen-Z coding assistant. \"\n",
    "    \"You are sarcastic but genuinely helpful. You use modern slang naturally, \"\n",
    "    \"but never let it get in the way of providing accurate, working code.\"\n",
    ")\n",
    "\n",
    "print(\"✅ Module 5 Dependencies & Golden System Prompt loaded.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 16. The ETL Pipeline Classes (Lessons 5.6 - 5.9)\n",
    "\n",
    "Here we define the four mathematical engines of our dataset pipeline."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class DataCleaner:\n",
    "    def __init__(self, raw_lines):\n",
    "        self.raw_lines = raw_lines\n",
    "        self.clean_dataset = []\n",
    "\n",
    "    def scrub_text(self, text):\n",
    "        if not isinstance(text, str): return \"\"\n",
    "        return text.replace('\\u200b', '').strip()\n",
    "\n",
    "    def clean_markdown_bleed(self, raw_string):\n",
    "        cleaned = raw_string.strip()\n",
    "        if cleaned.startswith(\"```json\"):\n",
    "            cleaned = cleaned.replace(\"```json\", \"\", 1)\n",
    "        elif cleaned.startswith(\"```\"):\n",
    "            cleaned = cleaned.replace(\"```\", \"\", 1)\n",
    "        if cleaned.endswith(\"```\"):\n",
    "            cleaned = cleaned[:cleaned.rfind(\"```\")]\n",
    "        return cleaned.strip()\n",
    "\n",
    "    def process(self):\n",
    "        for idx, raw_string in enumerate(self.raw_lines):\n",
    "            json_string = self.clean_markdown_bleed(raw_string)\n",
    "            try:\n",
    "                data = json.loads(json_string)\n",
    "            except json.JSONDecodeError:\n",
    "                continue\n",
    "\n",
    "            messages = data.get(\"messages\", [])\n",
    "            is_valid = True\n",
    "            for msg in messages:\n",
    "                # Prevent NaN losses by dropping completely empty responses\n",
    "                if msg.get(\"role\") == \"assistant\" and len(msg.get(\"content\", \"\").strip()) == 0:\n",
    "                    is_valid = False\n",
    "                    break\n",
    "            \n",
    "            if not is_valid: continue\n",
    "\n",
    "            for msg in messages:\n",
    "                msg[\"content\"] = self.scrub_text(msg.get(\"content\", \"\"))\n",
    "                \n",
    "            self.clean_dataset.append(data)\n",
    "\n",
    "class DatasetDeduplicator:\n",
    "    def __init__(self, dataset):\n",
    "        self.dataset = dataset\n",
    "        self.unique_dataset = []\n",
    "        self.seen_hashes = set()\n",
    "\n",
    "    def normalize_string(self, text):\n",
    "        text = text.lower()\n",
    "        text = re.sub(r'[^a-z0-9\\s]', '', text)\n",
    "        return re.sub(r'\\s+', ' ', text).strip()\n",
    "\n",
    "    def process(self):\n",
    "        for row in self.dataset:\n",
    "            conv_text = \" \".join([msg.get(\"content\", \"\") for msg in row.get(\"messages\", [])])\n",
    "            normalized = self.normalize_string(conv_text)\n",
    "            hash_val = hashlib.md5(normalized.encode('utf-8')).hexdigest()\n",
    "            \n",
    "            if hash_val not in self.seen_hashes:\n",
    "                self.seen_hashes.add(hash_val)\n",
    "                self.unique_dataset.append(row)\n",
    "\n",
    "class DatasetBalancer:\n",
    "    def __init__(self, dataset):\n",
    "        self.dataset = dataset\n",
    "        self.assistant_lengths = []\n",
    "        self.turn_counts = []\n",
    "\n",
    "    def process(self):\n",
    "        for row in self.dataset:\n",
    "            messages = row.get(\"messages\", [])\n",
    "            self.turn_counts.append(len(messages))\n",
    "            for msg in messages:\n",
    "                if msg.get(\"role\") == \"assistant\":\n",
    "                    self.assistant_lengths.append(len(msg.get(\"content\", \"\").split()))\n",
    "\n",
    "    def is_healthy(self):\n",
    "        if not self.turn_counts: return False\n",
    "        avg_turns = statistics.mean(self.turn_counts)\n",
    "        # We expect at least User -> Assistant (2 turns) on average\n",
    "        return avg_turns >= 2.0\n",
    "\n",
    "class DatasetFormatter:\n",
    "    def __init__(self, dataset):\n",
    "        self.dataset = dataset\n",
    "        self.formatted = []\n",
    "\n",
    "    def process(self):\n",
    "        for row in self.dataset:\n",
    "            standardized_messages = [{\"role\": \"system\", \"content\": SAHUR_SYSTEM_PROMPT}]\n",
    "            \n",
    "            # Force messy formats into the Hugging Face standard\n",
    "            if \"conversations\" in row:\n",
    "                for msg in row[\"conversations\"]:\n",
    "                    role = \"user\" if msg.get(\"speaker\") == \"human\" else \"assistant\"\n",
    "                    standardized_messages.append({\"role\": role, \"content\": msg.get(\"text\", \"\")})\n",
    "            elif \"dialogue\" in row:\n",
    "                for msg in row[\"dialogue\"]:\n",
    "                    role = \"user\" if msg.get(\"from\") == \"user\" else \"assistant\"\n",
    "                    standardized_messages.append({\"role\": role, \"content\": msg.get(\"value\", \"\")})\n",
    "            else:\n",
    "                for msg in row.get(\"messages\", []):\n",
    "                    if msg.get(\"role\") != \"system\":\n",
    "                        standardized_messages.append({\"role\": msg.get(\"role\"), \"content\": msg.get(\"content\", \"\")})\n",
    "            \n",
    "            self.formatted.append({\"messages\": standardized_messages})\n",
    "\n",
    "    def save_to_jsonl(self, path):\n",
    "        with open(path, \"w\", encoding=\"utf-8\") as f:\n",
    "            for row in self.formatted:\n",
    "                f.write(json.dumps(row) + \"\\n\")\n",
    "\n",
    "print(\"✅ Pipeline classes ready.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 17. The Unified Master ETL Pipeline (Lesson 5.10)\n",
    "\n",
    "Now we string the components together, simulate some incredibly dirty synthetic data, and push it through the pipeline to generate our final `sahur_genz_dataset.jsonl`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Simulate messy, dirty, duplicate synthetic data generated by a Teacher model\n",
    "raw_synthetic_data = [\n",
    "    # Row 1: Valid\n",
    "    \"\"\"{\"messages\": [{\"role\": \"user\", \"content\": \"how do i center a div?\"}, {\"role\": \"assistant\", \"content\": \"use flexbox bro. `display: flex; justify-content: center; align-items: center;`\"}]}\"\"\",\n",
    "    # Row 2: Markdown Bleed\n",
    "    \"\"\"```json\\n{\"messages\": [{\"role\": \"user\", \"content\": \"what is an int?\"}, {\"role\": \"assistant\", \"content\": \"an integer.\"}]}\\n```\"\"\",\n",
    "    # Row 3: Fuzzy Duplicate of Row 1 (Note the capitalization and punctuation differences)\n",
    "    \"\"\"{\"messages\": [{\"role\": \"user\", \"content\": \"how DO i center a div!?\"}, {\"role\": \"assistant\", \"content\": \"use flexbox bro. `display: flex; justify-content: center; align-items: center;`\"}]}\"\"\",\n",
    "    # Row 4: Empty Assistant (Constraint Failure)\n",
    "    \"\"\"{\"messages\": [{\"role\": \"user\", \"content\": \"write me a python script\"}, {\"role\": \"assistant\", \"content\": \"   \"}]}\"\"\",\n",
    "    # Row 5: Messy Format (Needs Adapter mapping)\n",
    "    \"\"\"{\"conversations\": [{\"speaker\": \"human\", \"text\": \"what is 2+2?\"}, {\"speaker\": \"bot\", \"text\": \"4.\"}]}\"\"\"\n",
    "]\n",
    "\n",
    "def master_data_pipeline(raw_rows, output_file_path):\n",
    "    print(\"🚀 Initiating Master Data Pipeline...\\n\")\n",
    "    \n",
    "    print(f\"[1/4] Cleaning {len(raw_rows)} raw rows...\")\n",
    "    cleaner = DataCleaner(raw_rows)\n",
    "    cleaner.process()\n",
    "    \n",
    "    print(f\"[2/4] Deduplicating {len(cleaner.clean_dataset)} clean rows...\")\n",
    "    deduper = DatasetDeduplicator(cleaner.clean_dataset)\n",
    "    deduper.process()\n",
    "    \n",
    "    print(f\"[3/4] Balancing {len(deduper.unique_dataset)} unique rows...\")\n",
    "    balancer = DatasetBalancer(deduper.unique_dataset)\n",
    "    balancer.process()\n",
    "    if not balancer.is_healthy():\n",
    "        raise Exception(\"🚨 Pipeline halted: Dataset balance is unhealthy.\")\n",
    "        \n",
    "    print(f\"[4/4] Formatting {len(deduper.unique_dataset)} rows to HF Standard...\")\n",
    "    formatter = DatasetFormatter(deduper.unique_dataset)\n",
    "    formatter.process()\n",
    "    \n",
    "    formatter.save_to_jsonl(output_file_path)\n",
    "    print(f\"\\n🎉 Pipeline Complete! Final dataset saved to '{output_file_path}'\")\n",
    "    print(f\"📊 Final Dataset Size: {len(formatter.formatted)} pristine rows.\")\n",
    "\n",
    "master_data_pipeline(raw_synthetic_data, \"sahur_genz_dataset.jsonl\")"
   ]
  },
  {
